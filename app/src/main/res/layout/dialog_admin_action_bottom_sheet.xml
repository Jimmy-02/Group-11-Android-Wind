<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Icon in circular background -->
    <FrameLayout
        android:id="@+id/layoutIconCircle"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_status_pending">

        <ImageView
            android:id="@+id/imgActionIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_delete"
            app:tint="#DC2626"
            tools:ignore="ContentDescription" />
    </FrameLayout>

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/tvActionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Xóa nội dung"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Dialog Warning Message -->
    <TextView
        android:id="@+id/tvActionMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="Bạn chắc chắn muốn xóa nội dung này? Hành động này sẽ chuyển trạng thái bài viết sang đã xóa và cập nhật các báo cáo liên quan."
        android:textColor="#64748B"
        android:textSize="13sp" />

    <!-- Reason Label -->
    <TextView
        android:id="@+id/tvReasonLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:text="Lý do xóa *"
        android:textColor="#334155"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Multiline EditText Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input_box"
        android:orientation="vertical"
        android:padding="10dp">

        <EditText
            android:id="@+id/etActionReason"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="@null"
            android:gravity="top|start"
            android:hint="Vui lòng nhập lý do quyết định của bạn..."
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:maxLength="500"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCharCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0/500"
            android:textColor="#94A3B8"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Error message for empty reason -->
    <TextView
        android:id="@+id/tvReasonError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Vui lòng nhập lý do (tối thiểu 5 ký tự)."
        android:textColor="#DC2626"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/pbActionLoading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:indeterminateTint="#6750A4"
        android:visibility="gone" />

    <!-- Action Buttons -->
    <LinearLayout
        android:id="@+id/layoutButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <!-- Nút Hủy -->
        <TextView
            android:id="@+id/btnCancelAction"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_outline"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Hủy"
            android:textColor="#475569"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Nút Xác nhận -->
        <TextView
            android:id="@+id/btnConfirmAction"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_btn_danger"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Xóa nội dung"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
