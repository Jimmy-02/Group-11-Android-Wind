<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F8FAFC">

    <ImageView
        android:id="@+id/img_placeholder_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="16dp"
        app:tint="#4F46E5"
        android:src="@drawable/ic_admin_space" />

    <TextView
        android:id="@+id/tv_placeholder_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quản trị"
        android:textColor="#0F172A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_placeholder_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Phân hệ đang được chuẩn bị triển khai cho Quản trị viên."
        android:textColor="#64748B"
        android:textSize="14sp" />

</LinearLayout>
