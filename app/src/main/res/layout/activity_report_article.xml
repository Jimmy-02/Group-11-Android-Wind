<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6F8">

    <View
        android:id="@+id/status_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#6750A4" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            android:padding="16dp"
            android:scaleType="fitCenter"
            app:tint="#172B4D" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Báo cáo bài báo"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#172B4D"
            android:gravity="center_vertical"
            android:paddingStart="4dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hãy cho chúng tôi biết vấn đề của bài báo này."
                android:textColor="#718096"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tv_report_article_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Article title"
                    android:textColor="#24344D"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_report_article_author"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Author name"
                    android:textColor="#718096"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Lý do báo cáo *"
                android:textColor="#24344D"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_report_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="12dp">

                <RadioButton
                    android:id="@+id/rb_misinformation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="5dp"
                    android:text="Thông tin khoa học sai lệch"
                    android:textColor="#24344D"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_plagiarism"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="5dp"
                    android:text="Đạo văn hoặc vi phạm bản quyền"
                    android:textColor="#24344D"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_fake_publication"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="5dp"
                    android:text="Bài báo hoặc nguồn xuất bản không xác thực"
                    android:textColor="#24344D"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_irrelevant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="5dp"
                    android:text="Không liên quan đến khoa học"
                    android:textColor="#24344D"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_inappropriate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="5dp"
                    android:text="Nội dung không phù hợp"
                    android:textColor="#24344D"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_spam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="5dp"
                    android:text="Spam hoặc quảng cáo"
                    android:textColor="#24344D"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_broken_link"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="5dp"
                    android:text="Liên kết bài báo bị lỗi"
                    android:textColor="#24344D"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_other"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="5dp"
                    android:text="Lý do khác"
                    android:textColor="#24344D"
                    android:textSize="14sp" />

            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Mô tả thêm (không bắt buộc)"
                android:textColor="#24344D"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_report_details"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:gravity="top|start"
                android:hint="Mô tả vấn đề bạn nhận thấy..."
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="500"
                android:padding="12dp"
                android:textColor="#24344D"
                android:textColorHint="#8290A3"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_submit_report"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="22dp"
                android:text="Gửi báo cáo"
                android:textAllCaps="false"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_cancel_report"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="#E8EDF3"
                android:text="Hủy"
                android:textAllCaps="false"
                android:textColor="#24344D"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>