<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- CỘT TRÁI: TIÊU ĐỀ, TÌM KIẾM, BỘ LỌC -->
        <ScrollView
            android:id="@+id/qnaScrollView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.36"
            android:background="#FFFFFF"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hỏi đáp"
                    android:textColor="#0F172A"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Đặt câu hỏi, chia sẻ kiến thức và trao đổi với cộng đồng."
                    android:textColor="#64748B"
                    android:textSize="12sp" />

                <!-- Tìm kiếm -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSearchQuestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Tìm câu hỏi..."
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSearchQuestions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:drawableStart="@android:drawable/ic_menu_search"
                        android:drawablePadding="8dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Tiêu đề bộ lọc -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Lọc câu hỏi"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Bộ lọc -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupQuestionFilter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:chipSpacingHorizontal="0dp"
                    app:chipSpacingVertical="7dp"
                    app:singleLine="false"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAllQuestions"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Tất cả câu hỏi" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMyQuestions"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Câu hỏi của tôi" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipUnanswered"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chưa trả lời" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAnswered"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Đã trả lời" />

                </com.google.android.material.chip.ChipGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#E2E8F0" />

                <!-- Sắp xếp -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Sắp xếp theo"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerQuestionSort"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="Sắp xếp câu hỏi" />

            </LinearLayout>
        </ScrollView>

        <!-- VẠCH NGĂN HAI CỘT -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E2E8F0" />

        <!-- CỘT PHẢI: DANH SÁCH CÂU HỎI -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.64"
            android:background="#F7F9FC">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvQuestions"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="80dp"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/tvEmptyQuestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="24dp"
                android:text="Chưa có câu hỏi nào"
                android:textColor="#718096"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/pbQuestions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <!-- NÚT ĐẶT CÂU HỎI -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAskQuestion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="18dp"
        android:contentDescription="Đặt câu hỏi"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#2864E8"
        app:tint="#FFFFFF" />

</FrameLayout>