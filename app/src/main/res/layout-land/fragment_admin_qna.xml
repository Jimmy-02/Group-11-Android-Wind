<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#F8FAFC">

    <!-- Cột trái: Tiêu đề, Tab, Tìm kiếm và Bộ lọc -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.35"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quản lý Q&amp;A"
                android:textColor="#0F172A"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Kiểm duyệt các nội dung bị báo cáo."
                android:textColor="#64748B"
                android:textSize="12sp" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_admin_qna"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:background="#FFFFFF"
                app:tabIndicatorColor="#2563EB"
                app:tabIndicatorHeight="3dp"
                app:tabSelectedTextColor="#2563EB"
                app:tabTextColor="#64748B"
                app:tabTextAppearance="@android:style/TextAppearance.Small"
                app:tabMode="fixed"
                app:tabGravity="fill" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="#E2E8F0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_search_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_search"
                    app:tint="#64748B"
                    android:contentDescription="Tìm kiếm" />

                <EditText
                    android:id="@+id/et_admin_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Tìm kiếm báo cáo..."
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch" />

                <ImageView
                    android:id="@+id/btn_clear_search"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_about"
                    app:tint="#94A3B8"
                    android:visibility="gone"
                    android:contentDescription="Xóa tìm kiếm" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Lọc theo trạng thái"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_filter_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_filter_chip_selected"
                android:gravity="center"
                android:padding="9dp"
                android:text="Tất cả"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_filter_pending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_filter_chip_unselected"
                android:gravity="center"
                android:padding="9dp"
                android:text="Chờ xử lý"
                android:textColor="#475569"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_filter_resolved"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_filter_chip_unselected"
                android:gravity="center"
                android:padding="9dp"
                android:text="Đã xử lý"
                android:textColor="#475569"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_filter_dismissed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_filter_chip_unselected"
                android:gravity="center"
                android:padding="9dp"
                android:text="Đã bác bỏ"
                android:textColor="#475569"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#E2E8F0" />

    <!-- Cột phải: Danh sách báo cáo Q&A (RecyclerView) -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.65">

        <ProgressBar
            android:id="@+id/pb_admin_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#2563EB"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_admin_reports"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp" />

        <LinearLayout
            android:id="@+id/layout_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_qna"
                app:tint="#CBD5E1"
                android:contentDescription="Trống" />

            <TextView
                android:id="@+id/tv_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Không có báo cáo nào"
                android:textColor="#334155"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_empty_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Tất cả các nội dung đều an toàn và đạt tiêu chuẩn cộng đồng."
                android:textColor="#94A3B8"
                android:textSize="13sp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
